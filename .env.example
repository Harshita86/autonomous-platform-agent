# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Platform (required, free) ---
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx
LINEAR_TEAM=Engineering

# --- LLM (set at least ONE; run `python cli.py doctor` to see which works) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Which providers to try, in order. First one that answers wins.
LLM_PROVIDER=anthropic,openai,gemini

# Optional model overrides (defaults are sensible; set only to change them)
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash

# Where the persistent memory lives (SQLite file). Kept out of git.
MEMORY_DB=memory.db
